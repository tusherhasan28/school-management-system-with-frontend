APP_NAME="School SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://schoolsaas.test
# Root platform domain. Schools live at {slug}.APP_DOMAIN, platform admin at admin.APP_DOMAIN
APP_DOMAIN=schoolsaas.test
# Storage timezone stays UTC; schools display in their own timezone (default Asia/Dhaka)
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Dhaka

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_saas
DB_USERNAME=school
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Keep null: host-only cookies so a session from one school is never sent to another
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@schoolsaas.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Platform super admin created by `php artisan platform:create-admin` (never commit real values)

# Billing (Milestone 7). Payment instructions shown on platform invoices
# (bank account / bKash merchant number); set per deployment.
BILLING_PAYMENT_INSTRUCTIONS=
BILLING_INVOICE_LEAD_DAYS=7
BILLING_SUPPORT_ACCESS_MAX_HOURS=24

# Messaging: the "log" SMS provider (nothing is sent) is on in local/testing only.
# MESSAGING_ALLOW_LOG_SMS=true

# Security headers (Milestone 8). CSP is on by default; REPORT_ONLY=true logs
# violations in the browser console without blocking. FORM_ACTION adds extra
# origins forms may post to (comma-separated). HSTS is sent on HTTPS only.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_FORM_ACTION=
SECURITY_HSTS_MAX_AGE=31536000

# Operations (Milestone 8): alert inbox for `ops:health --alert` and Horizon,
# and the token for https://admin.APP_DOMAIN/ops/health (empty = disabled).
OPS_ALERT_EMAIL=
OPS_HEALTH_TOKEN=
# Checks of Horizon, the scheduler heartbeat and backup age default to on in
# production only.
# OPS_CHECK_HORIZON=true
# OPS_CHECK_SCHEDULER=true
# OPS_CHECK_BACKUP=true
# OPS_BACKUP_MAX_AGE_HOURS=26
