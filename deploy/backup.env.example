# /etc/school-saas/backup.env  (chmod 600, owner root or the backup user)
# Read by scripts/backup.sh and scripts/restore.sh. Never commit real values.

APP_DIR=/var/www/school-saas/current
BACKUP_DIR=/var/backups/school-saas
DB_DATABASE=school_saas

# Encryption passphrase: generate once with `openssl rand -base64 48`, keep a
# copy in the team password manager. Without it the backups cannot be read.
BACKUP_PASSPHRASE_FILE=/etc/school-saas/backup.passphrase

# MySQL option file for a dedicated backup user:
#   [client]
#   user=backup
#   password=...
#   host=127.0.0.1
# Grants: SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES on school_saas.* and PROCESS globally.
BACKUP_MYSQL_DEFAULTS=/etc/school-saas/backup.my.cnf

BACKUP_KEEP_DAYS=14

# Off-server copy (strongly recommended): any rclone remote, e.g. Backblaze B2,
# Wasabi, S3 or another server over SFTP. Configure with `rclone config`.
BACKUP_RCLONE_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=35
