# .env for shared hosting (cPanel, Hostinger hPanel; no Redis, no root). Copy to
# the app folder's .env, fill every <...>, then: php artisan key:generate
# Never commit or share this file.

APP_NAME="School SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain.com>
# Schools live at {slug}.<your-domain.com>, platform admin at admin.<your-domain.com>
APP_DOMAIN=<your-domain.com>
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# cPanel → MySQL Databases. Names usually carry your cPanel username prefix.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpaneluser_school>
DB_USERNAME=<cpaneluser_app>
DB_PASSWORD=<database-password>
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Shared hosting has no Redis: sessions, cache and queue use the database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1900
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Behind Cloudflare (orange cloud): trust Cloudflare's addresses only.
TRUSTED_PROXIES=cloudflare

# Hosts without wildcard subdomains (Hostinger shared hosting): each school's
# subdomain is added in the hosting panel; the admin reminds you.
TENANCY_MANUAL_SUBDOMAINS=false

# cPanel → Email Accounts → create no-reply@<your-domain.com>, then "Connect Devices"
# shows the SMTP host and port (usually mail.<your-domain.com>, 465 with SSL).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.<your-domain.com>
MAIL_PORT=465
MAIL_USERNAME=no-reply@<your-domain.com>
MAIL_PASSWORD=<email-password>
MAIL_FROM_ADDRESS="no-reply@<your-domain.com>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BILLING_PAYMENT_INSTRUCTIONS="<bKash merchant / bank account for platform invoices>"
BILLING_INVOICE_LEAD_DAYS=7
BILLING_SUPPORT_ACCESS_MAX_HOURS=24

SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_FORM_ACTION=
SECURITY_HSTS_MAX_AGE=31536000

OPS_ALERT_EMAIL=<you@your-email.com>
# openssl rand -hex 24   (or any 40+ random letters/digits)
OPS_HEALTH_TOKEN=<long-random-token>
# No Horizon on shared hosting; the queue cron is watched instead.
OPS_CHECK_HORIZON=false
OPS_CHECK_SCHEDULER=true
OPS_CHECK_BACKUP=true
OPS_BACKUP_MAX_AGE_HOURS=26
